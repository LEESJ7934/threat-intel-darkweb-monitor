# MongoDB
DB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/darkweb?retryWrites=true&w=majority
DB_NAME=darkweb
DB_USER=replace_locally
DB_PASS=replace_locally

# Elasticsearch / Kibana
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Telegram
TELEGRAM_TOKEN=replace_locally
TELEGRAM_CHAT_ID=replace_locally

# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Crawler scheduler
CRAWLER_INTERVAL_MINUTES=30
CRAWLER_TIMEOUT_SECONDS=600

# Crawler browser (Tor must already be running locally)
TOR_SOCKS_PROXY=socks5://127.0.0.1:9150
CRAWLER_HEADLESS=True
CRAWLER_PAGE_TIMEOUT_SECONDS=60
CRAWLER_WAIT_SECONDS=20
